# Copy to .env and set the team TinyFish key. Never commit .env.
TINYFISH_API_KEY=
DEMO_URL=https://demo-booking-tau.vercel.app
DEMO_LOCAL_URL=http://127.0.0.1:8001
AGENTGUARD_DB=data/workflow.db
# Public backend: use deploy/fly.toml.template and a mounted volume; no API keys needed there.
# Optional operator-local parser smoke; never put this key into the public bundle.
OPENAI_API_KEY=
GUARD_LLM_MODEL=gpt-4.1-mini
